<!-- ClickHouse defaults for a single-node IForevents install. Mounted at
     /etc/clickhouse-server/config.d/ by docker-compose.yml.

     ClickHouse would otherwise claim 90% of the host's RAM and log every
     query at trace level. These caps leave room for the api, the dashboard
     and Redis on the same box; raise them on a dedicated host. -->
<clickhouse>
  <logger>
    <level>warning</level>
    <console>1</console>
  </logger>

  <!-- Default codec for every column that declares none: ZSTD(1) is about
       a quarter smaller than LZ4 on this data for little CPU. The events
       table names its own codecs; this does not override them. Read once at
       start: a change here needs the container recreated, not reloaded. -->
  <compression>
    <case>
      <method>zstd</method>
      <level>1</level>
    </case>
  </compression>

  <max_server_memory_usage_to_ram_ratio>0.6</max_server_memory_usage_to_ram_ratio>
  <max_concurrent_queries>64</max_concurrent_queries>
  <mark_cache_size>536870912</mark_cache_size>

  <!-- `BACKUP DATABASE iforevents TO Disk('backups', 'name.zip')` writes to
       ./backups on the host (bind-mounted by docker-compose.yml). -->
  <storage_configuration>
    <disks>
      <backups>
        <type>local</type>
        <path>/backups/</path>
      </backups>
    </disks>
  </storage_configuration>
  <backups>
    <allowed_disk>backups</allowed_disk>
    <allowed_path>/backups/</allowed_path>
  </backups>

  <!-- Parts a merge replaces stay on disk for old_parts_lifetime (480 s
       by default). At 20 events/s onto a 20 MB table that held 4.4 GB; 60 s
       held 1.0 GB (iforevents-api docs/STORAGE_BENCHMARK.md). They are kept
       so a hard reboot cannot lose a merged part not yet on disk, so every
       merged part is fsynced, with its directory, before it replaces them. -->
  <merge_tree>
    <old_parts_lifetime>60</old_parts_lifetime>
    <min_compressed_bytes_to_fsync_after_merge>1</min_compressed_bytes_to_fsync_after_merge>
    <fsync_part_directory>1</fsync_part_directory>
  </merge_tree>

  <!-- ClickHouse's own logs grow with time and queries, not with your data,
       and never expire by default: drop the profiling ones and keep the
       useful ones a week, as the hosted server does. -->
  <asynchronous_metric_log remove="1"/>
  <trace_log remove="1"/>
  <metric_log remove="1"/>
  <processors_profile_log remove="1"/>
  <query_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></query_log>
  <text_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></text_log>
  <part_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></part_log>

  <profiles>
    <default>
      <max_memory_usage>2000000000</max_memory_usage>
      <max_bytes_before_external_group_by>1000000000</max_bytes_before_external_group_by>
      <max_bytes_before_external_sort>1000000000</max_bytes_before_external_sort>
    </default>
  </profiles>
</clickhouse>

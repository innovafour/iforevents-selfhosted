# IForevents self-hosted: optional overrides.
#
# docker-compose.yml works with no .env at all. Copy this file to .env only
# to change something. Every line is optional.

# ---------------------------------------------------------------------------
# Version
# ---------------------------------------------------------------------------
# The compose file defaults to the newest release it was tested with; set a
# version here to move. "latest" follows the newest stable release.
# Releases: https://github.com/innovafour/iforevents-selfhosted/releases
IFOREVENTS_VERSION=1.1.0

# ---------------------------------------------------------------------------
# URLs and ports
# ---------------------------------------------------------------------------
# Where people open the dashboard and where your apps send events. With a
# domain (docker-compose.caddy.yml) both are https://analytics.example.com.
# The SDK snippets and the browser SDK URL (<API_PUBLIC_URL>/sdk/v1/
# iforevents.min.js, served by the api) follow API_PUBLIC_URL.
PUBLIC_URL=http://localhost:8010
API_PUBLIC_URL=http://localhost:8000

# Interface the two published ports bind to. Set 127.0.0.1 when a reverse
# proxy on the host (nginx, Caddy, Traefik) fronts the containers.
BIND_ADDRESS=0.0.0.0
DASHBOARD_PORT=8010
API_PORT=8000

# CIDRs allowed to set X-Forwarded-For (your reverse proxy). Empty means the
# api trusts nothing and rate-limits by the connecting address. The Caddy
# overlay needs the Docker network: 172.28.0.0/16 (DOCKER_SUBNET).
TRUSTED_PROXY_CIDRS=

# ---------------------------------------------------------------------------
# First admin
# ---------------------------------------------------------------------------
# Leave empty and the dashboard asks for the admin account on the first
# visit. Set both to create it at boot instead (unattended installs); the
# pair is ignored once any account exists. Change the password after login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ORGANIZATION_NAME=My organization

# bootstrap: the first signup creates the admin, then signup closes and new
#            users come from team invitations (default).
# closed:    no self-service signup at all.
# open:      anyone who reaches the dashboard can create an organization.
SIGNUP_MODE=bootstrap

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Signs dashboard sessions. Generated on first boot into the api_data volume
# when empty; set it explicitly to control it (32+ bytes):
#   openssl rand -base64 48
TOKEN_SECRET=

# Internal services are not published on the host, so the defaults are only
# reachable from inside the Docker network. Change them on a shared host.
#   openssl rand -base64 24
DB_PASSWORD=iforevents

# ---------------------------------------------------------------------------
# Outbound e-mail (invitations, verification, password reset)
# ---------------------------------------------------------------------------
# Resend (https://resend.com) is the simplest option: an API key and a From
# address on a domain verified in your Resend account. SMTP_* works with any
# relay instead. Without either, accounts are verified on creation and reset
# links are printed to `docker compose logs api`.
RESEND_API_KEY=
RESEND_FROM=Analytics <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
# Days of raw events to keep; 0 keeps everything.
EVENTS_RETENTION_DAYS=0
# Ingest ceiling per organization (events per second, and burst).
RATE_LIMIT_INGEST_RATE=500
RATE_LIMIT_INGEST_BURST=2000

# ---------------------------------------------------------------------------
# Reverse proxy with automatic TLS (docker-compose.caddy.yml)
# ---------------------------------------------------------------------------
# DOMAIN=analytics.example.com
# ACME_EMAIL=you@example.com
# PUBLIC_URL=https://analytics.example.com
# API_PUBLIC_URL=https://analytics.example.com
# BIND_ADDRESS=127.0.0.1
# TRUSTED_PROXY_CIDRS=172.28.0.0/16

LOG_LEVEL=INFO
